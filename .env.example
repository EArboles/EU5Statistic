# ============================================================================
# EU5Statistics configuration
# ============================================================================
# Скопируйте этот файл в .env и заполните значения под свою систему.
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
# ============================================================================


# ============================================================================
# Обязательно
# ============================================================================


# Строка подключения к PostgreSQL
#
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Пример для локального PostgreSQL:
#DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eu5statistic
DATABASE_URL=


# Путь к rakaly — CLI-утилите для конвертации бинарных файлов Paradox.
#
# Рекомендуется использовать форк от pdx_unlimiter (проверенный, работает стабильнее):
#   https://github.com/crschnick/pdx_unlimiter/tree/master/rakaly
#
# Оригинал (если форк не подходит):
#   https://github.com/rakaly/cli
#
# Порядок действий:
#  Windows: скачайте rakaly.exe, положите в папку (например, C:/tools/rakaly/), добавьте её в PATH или укажите RAKALY_PATH в .env.
#  Linux/macOS: скачайте бинарник, сделайте chmod +x rakaly, положите в ~/.local/bin/ или /usr/local/bin/ (если они в PATH) или укажите RAKALY_PATH в .env.
#
# Если не указан, ищется в переменных окружения
RAKALY_PATH=



# Корневая папка установки игры (папка "game" внутри EU5).
#
# Примеры пути до папки
#   Windows (Steam): C:/Program Files (x86)/Steam/steamapps/common/Europa Universalis V/game
#   Linux (Steam): ~/.local/share/Steam/steamapps/common/Europa Universalis V/game
#   macOS: ~/Library/Application Support/Steam/steamapps/common/Europa Universalis V/game
GAME_FOLDER=


# Папка для данных приложения (logs, processed, errors, cache).
# Если не задана — создается папка data в корне проекта: ./data
DATA_DIR=

# ============================================================================
# Опционально
# ============================================================================


# Папка профиля игрока Paradox для EU5 (там где pdx_settings.json, playsets.json, save games)
#
# Примеры пути до папки
#   Windows: C:/Users/<User>/Documents/Paradox Interactive/Europa Universalis V
#   Linux:   ~/.local/share/Paradox Interactive/Europa Universalis V
#   macOS:   ~/Documents/Paradox Interactive/Europa Universalis V
#
# Если не указан, то проводится автоопределение.
USER_DATA_FOLDER=


# Логировать SQL-запросы в консоль (true/false). Полезно для отладки.
SQL_ECHO=false


# Год начала обработки
INITIAL_YEAR=1337
# Периодичность обработки (Например: каждый год, 5 или 10 лет)
PERIOD_SIZE=5

# Ширина колонок в логах (в символах)
LOG_FILENAME_WIDTH=50
LOG_STATUS_WIDTH=12